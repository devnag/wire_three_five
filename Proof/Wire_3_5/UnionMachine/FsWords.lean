theorem binCost_le (g k cap : ℕ) (hg : g ≤ cap) (hk : k ≤ cap) : BinW.binCost g k ≤ 60 * ((cap + 1) * (cap + 1)) := by
  unfold BinW.binCost
  rw [Nat.mul_assoc]
  exact Nat.mul_le_mul le_rfl (Nat.mul_le_mul (by omega) (by omega))

