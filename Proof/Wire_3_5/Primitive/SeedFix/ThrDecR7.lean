/-- Add the registers `rs` into `dK` in turn. -/
def addsW : List (Fin LNR) → WM (LNS x) LNR
  | [] => .skip
  | r :: rs => .seq (addTo r dK TM) (addsW rs)

theorem adds_run : ∀ (rs : List (Fin LNR)) (σ : WState (LNS x) LNR) (acc : ℕ), (∀ r ∈ rs, r ≠ dK ∧ r ≠ TM) →
    σ.val dK = acc → σ.val TM = 0 → acc + (rs.map σ.val).sum ≤ cap → (∀ r ∈ rs, σ.val r ≤ cap) →
    WExec cap (addsW x rs) σ (σ.setv dK (acc + (rs.map σ.val).sum)) (rs.length * (UnaryPow.sq cap + 1))
  | [], σ, acc, _, hK, _, _, _ => by
    have e : σ.setv dK (acc + (([] : List (Fin LNR)).map σ.val).sum) = σ := by
      simp only [List.map_nil, List.sum_nil, Nat.add_zero]; rw [← hK, wsetv_same]
    rw [e]; exact WExec.mono (WExec.skip σ) (by simp)
  | r :: rs, σ, acc, hr, hK, hT, hc, hb => by
    have hr0 := hr r (by simp)
    have e1 := add1 cap r dK TM hr0.1 hr0.2 (by decide) (σ.val r) acc σ rfl hK hT (hb r (by simp))
      (by simp at hc; omega)
    have hmap : (rs.map (σ.setv dK (acc + σ.val r)).val) = rs.map σ.val := by
      apply List.map_congr_left
      intro r' hr'
      simp only [WState.setv_val]
      rw [Function.update_of_ne (hr r' (by simp [hr'])).1]
    have e2 := adds_run rs (σ.setv dK (acc + σ.val r)) (acc + σ.val r) (fun r' h => hr r' (by simp [h]))
      (by simp) (by simp only [WState.setv_val]; rw [Function.update_of_ne (by decide)]; exact hT)
      (by rw [hmap]; simp at hc; omega) (fun r' h => by
        simp only [WState.setv_val]; rw [Function.update_of_ne (hr r' (by simp [h])).1]; exact hb r' (by simp [h]))
    rw [hmap, wsetv_setv] at e2
    have e3 : acc + σ.val r + (rs.map σ.val).sum = acc + ((r :: rs).map σ.val).sum := by simp; omega
    rw [e3] at e2
    have hs := UnaryPow.sq_ge cap
    refine WExec.mono (WExec.seq e1 e2) ?_
    simp only [List.length_cons]; nlinarith

/-- The registers summed for the data tape's rewind count. -/
def eRegs : List (Fin LNR) :=
  [Hb 1, Hb 2, Hb 3, Hb 4, Hb 5, Hb 6, Hb 7, Hb 8, Hb 9, Hb 10, Hb 11, Hb 12, Hb 13, Hb 14, Hb 15, XA, XB, Hb 0]

theorem eRegs_ok : ∀ r ∈ eRegs, r ≠ dK ∧ r ≠ TM := by decide

/-- **The data tape's rewind count**: `dK := Σ_k hashNums_k + |X_0| + |X_1| + |carriers| + 16`. -/
def tEW : WM (LNS x) LNR :=
  .seq (FinalPass.Hash4.wcopyR (Hb 0) dK TM) (.seq (addsW x eRegs) (StarNums.incN dK 16))

theorem tE_run (σ : WState (LNS x) LNR) (zK : σ.val dK = 0) (zT : σ.val TM = 0)
    (hc : σ.val (Hb 0) + (eRegs.map σ.val).sum + 16 ≤ cap) (hb : ∀ q, σ.val q ≤ cap) :
    WExec cap (tEW x) σ (σ.setv dK (σ.val (Hb 0) + (eRegs.map σ.val).sum + 16))
      (UnaryPow.sq cap + 1 + (eRegs.length * (UnaryPow.sq cap + 1) + 1 + UnaryPow.sq cap)) := by
  have e1 := copy1 cap (Hb 0) dK TM (by decide) (by decide) (by decide) (σ.val (Hb 0)) σ rfl zK zT (hb _)
  have hmap : eRegs.map (σ.setv dK (σ.val (Hb 0))).val = eRegs.map σ.val := by
    apply List.map_congr_left
    intro r hr
    simp only [WState.setv_val]; rw [Function.update_of_ne (eRegs_ok r hr).1]
  have e2 := adds_run cap x eRegs (σ.setv dK (σ.val (Hb 0))) (σ.val (Hb 0)) eRegs_ok (by simp)
    (by simp only [WState.setv_val]; rw [Function.update_of_ne (by decide)]; exact zT) (by rw [hmap]; omega)
    (fun r hr => by simp only [WState.setv_val]; rw [Function.update_of_ne (eRegs_ok r hr).1]; exact hb r)
  rw [hmap, wsetv_setv] at e2
  have e3 := FiltNum.incN1 cap dK (σ.val (Hb 0) + (eRegs.map σ.val).sum) 16
    (σ.setv dK (σ.val (Hb 0) + (eRegs.map σ.val).sum)) (by simp) (by omega)
  rw [wsetv_setv] at e3
  exact WExec.seq e1 (WExec.seq e2 e3)

end R7

