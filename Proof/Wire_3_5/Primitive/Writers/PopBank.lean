/-- The phases A1, A2 keep every register outside `G 13 … G 19`, `H 20`, `H 21`, `H 24 … H 32`. -/
theorem pA_other (σ : WState ns LNR) (r nc x m0 m1 m2 m3 : ℕ) (q : Fin LNR)
    (hq : q.val < 421 ∨ (427 < q.val ∧ q.val < 492) ∨ q.val = 494 ∨ q.val = 495 ∨ 504 < q.val) :
    (pA2Out (pA1Out σ r nc x m0 m1 m2 m3) x m0 m1 m2 m3).val q = σ.val q := by
  have n1 : q.val ≠ 421 := by omega
  have n2 : q.val ≠ 422 := by omega
  have n3 : q.val ≠ 423 := by omega
  have n4 : q.val ≠ 424 := by omega
  have n5 : q.val ≠ 425 := by omega
  have n6 : q.val ≠ 426 := by omega
  have n7 : q.val ≠ 427 := by omega
  have n8 : q.val ≠ 492 := by omega
  have n9 : q.val ≠ 493 := by omega
  have n10 : q.val ≠ 496 := by omega
  have n11 : q.val ≠ 497 := by omega
  have n12 : q.val ≠ 498 := by omega
  have n13 : q.val ≠ 499 := by omega
  have n14 : q.val ≠ 500 := by omega
  have n15 : q.val ≠ 501 := by omega
  have n16 : q.val ≠ 502 := by omega
  have n17 : q.val ≠ 503 := by omega
  have n18 : q.val ≠ 504 := by omega
  unfold pA2Out pA1Out
  simp [Function.update_apply, Fin.ext_iff, G_val, H_val, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14,
