/-- Phase A1: `i`, `p` (`H 20`, `H 21`), the divisors `m_k + 1` (`G 13 … G 16`), the index `x` copied (`H 24`). -/
def pA1W : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR (H 9) (H 20) TM) (.seq (UnaryArith.subW pbSub) (.seq (WriteNat.halveM (H 20) (G 50) (H 21))
  (.seq (FinalPass.Hash4.wcopyR dM0 (G 13) TM) (.seq (.inc (G 13)) (.seq (FinalPass.Hash4.wcopyR dM1 (G 14) TM)
  (.seq (.inc (G 14)) (.seq (FinalPass.Hash4.wcopyR dM2 (G 15) TM) (.seq (.inc (G 15))
  (.seq (FinalPass.Hash4.wcopyR dM3 (G 16) TM) (.seq (.inc (G 16)) (FinalPass.Hash4.wcopyR (H 15) (H 24) TM)))))))))))

/-- Phase A2: the digits `x mod (m_k+1)`, `x/(m_k+1) mod (m_k+1)` (`H 24 … H 31`), the prefix sums (`G 17 … G 19`). -/
def pA2W : WM ns LNR :=
  .seq (divW pbDv0) (.seq (divW pbDv1) (.seq (divW pbDv2) (.seq (divW pbDv3) (.seq (divW pbDv4) (.seq (divW pbDv5)
  (.seq (divW pbDv6) (.seq (divW pbDv7)
  (.seq (FinalPass.Hash4.wcopyR dM0 (G 17) TM) (.seq (FinalPass.Hash4.wcopyR dM0 (G 18) TM) (.seq (addTo dM1 (G 18) TM)
  (.seq (FinalPass.Hash4.wcopyR dM0 (G 19) TM) (.seq (addTo dM1 (G 19) TM) (addTo dM2 (G 19) TM)))))))))))))

/-- The ladder's case `k`: `m_k` (`H 22`), `t_k^+` (`G 22`), `t_k^−` (`G 23`), `Σ_{j<k} m_j` (`H 23`). -/
def pC0W : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR dM0 (H 22) TM) (.seq (FinalPass.Hash4.wcopyR (H 25) (G 22) TM)
    (FinalPass.Hash4.wcopyR (H 24) (G 23) TM))
def pC1W : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR dM1 (H 22) TM) (.seq (FinalPass.Hash4.wcopyR (H 27) (G 22) TM)
    (.seq (FinalPass.Hash4.wcopyR (H 26) (G 23) TM) (FinalPass.Hash4.wcopyR (G 17) (H 23) TM)))
def pC2W : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR dM2 (H 22) TM) (.seq (FinalPass.Hash4.wcopyR (H 29) (G 22) TM)
    (.seq (FinalPass.Hash4.wcopyR (H 28) (G 23) TM) (FinalPass.Hash4.wcopyR (G 18) (H 23) TM)))
def pC3W : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR dM3 (H 22) TM) (.seq (FinalPass.Hash4.wcopyR (H 31) (G 22) TM)
    (.seq (FinalPass.Hash4.wcopyR (H 30) (G 23) TM) (FinalPass.Hash4.wcopyR (G 19) (H 23) TM)))

/-- Phase L: the circuit ladder on `i` (`H 20`). -/
def pLW : WM ns LNR :=
  .ifr (H 20) (.seq (.dec (H 20)) (.ifr (H 20) (.seq (.dec (H 20)) (.ifr (H 20) pC3W pC2W)) pC1W)) pC0W

/-- Phase T: the clamp `c` (`G 29`), the compared digit (`G 30`), the flags `[c < t]`, `[t < c]` (`G 31`, `G 57`). -/
def pTW : WM ns LNR :=
  .seq (gtFlagW pbGtC) (.seq (.ifr (G 25) .skip (FinalPass.Hash4.wcopyR (H 12) (G 29) TM))
    (.seq (.ifr (H 21) (FinalPass.Hash4.wcopyR (G 23) (G 30) TM) (FinalPass.Hash4.wcopyR (G 22) (G 30) TM))
    (.seq (gtFlagW pbGtE1) (gtFlagW pbGtE2))))

/-- Phase M: the entry bank `ppM … ppL` but the sign. -/
def pMW : WM ns LNR :=
  .seq (FinalPass.Hash4.wcopyR (G 32) ppM TM) (.seq (FinalPass.Hash4.wcopyR (G 33) ppB TM)
  (.seq (FinalPass.Hash4.wcopyR (G 34) ppErr TM) (.seq (FinalPass.Hash4.wcopyR (H 17) ppSeed TM)
  (.seq (FinalPass.Hash4.wcopyR (H 12) ppS TM) (.seq (FinalPass.Hash4.wcopyR (H 13) ppR4 TM)
  (.seq (dbl ppR4 TM) (.seq (dbl ppR4 TM) (.seq (FinalPass.Hash4.wcopyR XA ppG TM) (.seq (addTo XB ppG TM)
  (.seq (dbl ppG TM) (.seq (addTo dMS ppG TM) (.seq (WM.clear ppOff) (.seq (WM.clear ppL)
  (.seq (FinalPass.Hash4.wcopyR XA ppOff TM) (.seq (addTo XB ppOff TM) (.seq (dbl ppOff TM) (.seq (addTo (H 23) ppOff TM)
    (FinalPass.Hash4.wcopyR (H 22) ppL TM))))))))))))))))))


