    unfold sel4; split_ifs <;> omega
  -- phase T
  obtain ⟨τT, cT, eT, cTb, t31, t57, kT, stT, shT, clT⟩ := pT_run cap τL s (sel4 ((r - nc) / 2) m0 m1 m2 m3)
