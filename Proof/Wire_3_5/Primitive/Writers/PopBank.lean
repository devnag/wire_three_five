/-- The circuit `i`'s entry of four values. -/
def sel4 (i v0 v1 v2 v3 : ℕ) : ℕ := if i = 0 then v0 else if i = 1 then v1 else if i = 2 then v2 else v3

section Bank
variable (cap : ℕ) {ns : ℕ}

/-- `a := a − b` within one unit. -/
theorem pbSub1 (R : Fin 4 ↪ Fin LNR) (a b : ℕ) (σ : WState ns LNR) (ha : σ.val (R 0) = a) (hb : σ.val (R 1) = b)
    (h2 : σ.val (R 2) = 0) (h3 : σ.val (R 3) = 0) (hac : a ≤ cap) (hbc : b ≤ cap) :
    WExec cap (UnaryArith.subW R) σ (σ.setv (R 0) (a - b)) (UnaryPow.sq cap) := by
  have h := UnaryArith.subW_spec cap R σ h2 h3 (by rw [ha]; exact hac) (by rw [hb]; exact hbc)
  rw [ha, hb] at h
  have hs := UnaryPow.lin_le_sq cap
  exact WExec.mono h (by omega)

