    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by rw [k2 _ (by rw [rv_TM]; omega)]; exact zTM)
    (by rw [k2 _ (by rw [H_val]; decide)]; exact zH 22 (by decide) (by decide))
    (by rw [k2 _ (by rw [H_val]; decide)]; exact zH 23 (by decide) (by decide))
    (by rw [k2 _ (by rw [G_val]; decide)]; exact zG 22 (by decide) (by decide))
    (by rw [k2 _ (by rw [G_val]; decide)]; exact zG 23 (by decide) (by decide))
    (by
      have := Nat.div_le_self x (m0 + 1)
      have : (r - nc) / 2 ≤ r := le_trans (Nat.div_le_self _ _) (Nat.sub_le _ _)
      have := Nat.mod_lt (x / (m0 + 1)) (show 0 < m0 + 1 by omega)
      have := Nat.mod_lt x (show 0 < m0 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1) / (m1 + 1)) (show 0 < m1 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1)) (show 0 < m1 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1)) (show 0 < m2 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1)) (show 0 < m2 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1) / (m3 + 1))
        (show 0 < m3 + 1 by omega)
      have := Nat.mod_lt (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1)) (show 0 < m3 + 1 by omega)
