/-- The registers `410 … 511` (the blocks `G`, `H` but `ppOff`, `ppL`). -/
def gh2 : List (Fin LNR) := (List.finRange 62).map (fun i => G ⟨i.val + 2, by omega⟩) ++ (List.finRange 40).map H

theorem gh2_length : gh2.length = 102 := by simp [gh2]

theorem mem_gh2 (q : Fin LNR) (h : 410 ≤ q.val) : q ∈ gh2 := by
  have hq : q.val < 512 := q.isLt
  unfold gh2
  rw [List.mem_append]
  by_cases h2 : q.val < 472
  · left; rw [List.mem_map]
    exact ⟨⟨q.val - 410, by omega⟩, List.mem_finRange _, Fin.ext (by rw [G_val]; simp only; omega)⟩
  · right; rw [List.mem_map]
    exact ⟨⟨q.val - 472, by omega⟩, List.mem_finRange _, Fin.ext (by rw [H_val]; simp only; omega)⟩

theorem not_mem_gh2 (q : Fin LNR) (h : q.val < 410) : q ∉ gh2 := by
  unfold gh2
  rw [List.mem_append, List.mem_map, List.mem_map]
  rintro (⟨i, -, hi⟩ | ⟨k, -, hk⟩)
  · have := congrArg Fin.val hi; rw [G_val] at this; simp only at this; omega
  · have := congrArg Fin.val hk; rw [H_val] at this; omega

/-- The joint state's index after the divisions by the first `i` circuits' `(m_k+1)²`. -/
def pbX (x m0 m1 m2 i : ℕ) : ℕ :=
  sel4 i x (x / (m0 + 1) / (m0 + 1)) (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1))
    (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1))

/-- **The compared digit**: circuit `i`'s `t_i^+` (sign `p = 0`) or `t_i^−` (`SymDecEnum.stateDigit`). -/
def pbT (x m0 m1 m2 m3 i p : ℕ) : ℕ :=
  if p = 0 then pbX x m0 m1 m2 i / (sel4 i m0 m1 m2 m3 + 1) % (sel4 i m0 m1 m2 m3 + 1)
  else pbX x m0 m1 m2 i % (sel4 i m0 m1 m2 m3 + 1)

/-- **The clamp** `[s ≤ m]·s` (`Rows.clampState`). -/
def pbC (s m : ℕ) : ℕ := if m < s then 0 else s

/-- The zero `G` registers the bank uses as scratch. -/
def pbZ : List ℕ := [13, 14, 15, 16, 17, 18, 19, 22, 23, 25, 26, 27, 28, 29, 30, 31, 42, 43, 44, 45, 46, 47, 48, 49, 50, 57]

section Run
variable (cap : ℕ) (W : WalkBankProducer)

/-- **The POP bank**: the digits, the circuit ladder, the clamp and the match; on the match the entry bank, the sign,
the clearing of every register from `410` on, and the POP setup. -/
def pbW (Q : PopSetupSpec W) : WM (LNS W.x) LNR :=
  .seq pA1W (.seq pA2W (.seq pLW (.seq pTW (.ifr (G 31) .skip (.ifr (G 57) .skip
    (.seq pMW (.seq (.ifr (H 21) .skip (.inc ppSgn)) (.seq (clrsW gh2) Q.prog))))))))

/-- The bank's cost before the POP setup. -/
def pbCost (c : ℕ) : ℕ := 260 * UnaryPow.sq c

theorem pbT_eq (x m0 m1 m2 m3 i p : ℕ) (hi : i ≤ 3) :
    (if p = 0 then sel4 i (x / (m0 + 1) % (m0 + 1)) (x / (m0 + 1) / (m0 + 1) / (m1 + 1) % (m1 + 1))
        (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) % (m2 + 1))
        (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1) / (m3 + 1) % (m3 + 1))
      else sel4 i (x % (m0 + 1)) (x / (m0 + 1) / (m0 + 1) % (m1 + 1))
        (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) % (m2 + 1))
        (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1) % (m3 + 1))) =
      pbT x m0 m1 m2 m3 i p := by
  unfold pbT pbX
  interval_cases i <;> simp [sel4]

/-- **The POP bank, run** (generic in the decoded values): the request and counter kept; on the clamp's match the
POP flag and `PopReady` at the list seed `f`, circuit `i = (r − nc)/2`'s slice and sign; otherwise the streams
unchanged. -/
theorem pb_run (Q : PopSetupSpec W) (σ : WState (LNS W.x) LNR) (w out u : List Bool) (j : ℕ)
    (r nc s row x f m0 m1 m2 m3 M Bv ev xa xb Ms : ℕ)
    (hst : σ.st = (CellLoopD.blankCellD W.x w out j u).st)
    (hsh : ∀ s', s' ≠ sk W.x 113 → σ.sh s' = (CellLoopD.blankCellD W.x w out j u).sh s') (hcl : σ.cell = false)
    (hzl : ∀ q : Fin LNR, q.val < 250 → σ.val q = 0) (zfs : ∀ q : Fin LNR, 400 ≤ q.val → q.val < 408 → σ.val q = 0)
    (zTM : σ.val TM = 0) (hB : ∀ q, σ.val q ≤ cap)
    (h9 : σ.val (H 9) = r) (h12 : σ.val (H 12) = s) (h13 : σ.val (H 13) = row) (h15 : σ.val (H 15) = x)
    (h17 : σ.val (H 17) = f) (hz : ∀ k : Fin 40, 20 ≤ k.val → σ.val (H k) = 0)
    (gz : ∀ i : Fin 64, i.val ∈ pbZ → σ.val (G i) = 0)
    (g32 : σ.val (G 32) = M) (g33 : σ.val (G 33) = Bv) (g34 : σ.val (G 34) = ev)
    (vNC : σ.val dNC = nc) (v0 : σ.val dM0 = m0) (v1 : σ.val dM1 = m1) (v2 : σ.val dM2 = m2) (v3 : σ.val dM3 = m3)
    (vA : σ.val XA = xa) (vB : σ.val XB = xb) (vMS : σ.val dMS = Ms)
    (hi : (r - nc) / 2 ≤ 3) (hsM : s < M + 1) (hf : f < Fintype.card (FlatListParams.FlatSeed ⟨M, Bv, ev⟩))
    (hc : r + nc + x + 4 * (m0 + m1 + m2 + m3) + M + Bv + ev + f + s + 4 * row + 2 * (xa + xb) + Ms + 20 ≤ cap)
    (hneed : Q.need ⟨M, Bv, ev⟩ (sel4 ((r - nc) / 2) m0 m1 m2 m3) (2 * (2 * row)) (2 * (xa + xb) + Ms)
      (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2)) ≤ cap) :
    ∃ τ c, WExec cap (pbW W Q) σ τ c ∧ c ≤ pbCost cap + Q.bound cap ∧
      τ.st (sk W.x 0) = frame w ∧ τ.st (sk W.x 2) = List.replicate j true ∧ τ.sh (sk W.x 2) = 0 ∧
      (pbC s (sel4 ((r - nc) / 2) m0 m1 m2 m3) = pbT x m0 m1 m2 m3 ((r - nc) / 2) ((r - nc) % 2) →
        τ.st (sk W.x 150) = [true] ∧ τ.sh (sk W.x 150) = 0 ∧
        ∃ hlabs : 4 * sel4 ((r - nc) / 2) m0 m1 m2 m3 ≤ (sliceLabs (2 * (2 * row)) (2 * (xa + xb) + Ms)
            (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2)) (sel4 ((r - nc) / 2) m0 m1 m2 m3)).length,
          PopReady cap W τ out ⟨M, Bv, ev⟩ ((Enum.flatSeedEquiv ⟨M, Bv, ev⟩).symm ⟨f, hf⟩)
            (sel4 ((r - nc) / 2) m0 m1 m2 m3) (2 * (2 * row)) (2 * (xa + xb) + Ms)
            (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2))
            (popMlab (2 * (2 * row)) (2 * (xa + xb) + Ms) (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2))
              (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popLw ⟨M, Bv, ev⟩ (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popCAP (2 * (2 * row)) (2 * (xa + xb) + Ms) (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2))
              (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popLL (2 * (2 * row)) (2 * (xa + xb) + Ms) (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2))
              (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popR ⟨M, Bv, ev⟩ (2 * (2 * row)) (2 * (xa + xb) + Ms)
              (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2)) (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popCp ⟨M, Bv, ev⟩ (2 * (2 * row)) (2 * (xa + xb) + Ms)
              (2 * (xa + xb) + sel4 ((r - nc) / 2) 0 m0 (m0 + m1) (m0 + m1 + m2)) (sel4 ((r - nc) / 2) m0 m1 m2 m3))
            (popRW ⟨M, Bv, ev⟩) (popRW ⟨M, Bv, ev⟩) (decide ((r - nc) % 2 = 0)) ⟨s, hsM⟩ hlabs) ∧
      (pbC s (sel4 ((r - nc) / 2) m0 m1 m2 m3) ≠ pbT x m0 m1 m2 m3 ((r - nc) / 2) ((r - nc) % 2) →
        τ.st = σ.st ∧ τ.sh = σ.sh) := by
  have hsq := UnaryPow.sq_ge cap
  have hl := UnaryPow.lin_le_sq cap
  have zH : ∀ k : ℕ, (hk : k < 40) → 20 ≤ k → σ.val (H ⟨k, hk⟩) = 0 := fun k hk h => hz ⟨k, hk⟩ h
  have zG : ∀ k : ℕ, (hk : k < 64) → k ∈ pbZ → σ.val (G ⟨k, hk⟩) = 0 := fun k hk h => gz ⟨k, hk⟩ h
  -- phase A1
  have eA1 := pA1_run cap σ r nc x m0 m1 m2 m3 h9 vNC h15 v0 v1 v2 v3 zTM (zH 20 (by decide) (by decide))
    (zH 21 (by decide) (by decide)) (zH 24 (by decide) (by decide)) (zG 13 (by decide) (by decide))
    (zG 14 (by decide) (by decide)) (zG 15 (by decide) (by decide)) (zG 16 (by decide) (by decide))
    (zG 48 (by decide) (by decide)) (zG 49 (by decide) (by decide)) (zG 50 (by decide) (by decide)) (by omega)
  -- phase A2
  have eA2 := pA2_run cap (pA1Out σ r nc x m0 m1 m2 m3) x m0 m1 m2 m3
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val, rv_dM0, v0])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val, rv_dM1, v1])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val, rv_dM2, v2])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val, rv_TM, zTM])
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 25 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 26 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 27 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 28 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 29 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 30 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 31 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zH 32 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 42 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 43 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 44 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 45 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 46 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 47 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 17 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 18 (by decide) (by decide))
    (by simp [pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]; exact zG 19 (by decide) (by decide))
    (by omega)
  obtain ⟨σ2, hσ2⟩ : ∃ y, y = pA2Out (pA1Out σ r nc x m0 m1 m2 m3) x m0 m1 m2 m3 := ⟨_, rfl⟩
  rw [← hσ2] at eA2
  have k2 : ∀ q : Fin LNR, (q.val < 421 ∨ (427 < q.val ∧ q.val < 492) ∨ q.val = 494 ∨ q.val = 495 ∨ 504 < q.val) →
      σ2.val q = σ.val q := fun q hq => by rw [hσ2]; exact pA_other σ r nc x m0 m1 m2 m3 q hq
  have st2 : σ2.st = σ.st := by rw [hσ2]; exact pA_st σ r nc x m0 m1 m2 m3
  have sh2 : σ2.sh = σ.sh := by rw [hσ2]; exact pA_sh σ r nc x m0 m1 m2 m3
  have cl2 : σ2.cell = σ.cell := by rw [hσ2]; exact pA_cell σ r nc x m0 m1 m2 m3
  have hB2 : ∀ q, σ2.val q ≤ cap := wexec_le cap eA2 (wexec_le cap eA1 hB)
  have a20 : σ2.val (H 20) = (r - nc) / 2 := by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]
  have a21 : σ2.val (H 21) = (r - nc) % 2 := by rw [hσ2]; simp [pA2Out, pA1Out, Function.update_apply, Fin.ext_iff, G_val, H_val]
  -- phase L
  obtain ⟨τL, cL, eL, cLb, l22, lg22, lg23, l23, kL, stL, shL, clL⟩ := pL_run cap σ2 ((r - nc) / 2) m0 m1 m2 m3
    (x / (m0 + 1) % (m0 + 1)) (x % (m0 + 1)) (x / (m0 + 1) / (m0 + 1) / (m1 + 1) % (m1 + 1))
    (x / (m0 + 1) / (m0 + 1) % (m1 + 1))
    (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) % (m2 + 1))
    (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) % (m2 + 1))
    (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1) / (m3 + 1) % (m3 + 1))
    (x / (m0 + 1) / (m0 + 1) / (m1 + 1) / (m1 + 1) / (m2 + 1) / (m2 + 1) % (m3 + 1)) a20 hi
    (by rw [k2 _ (by rw [rv_dM0]; omega)]; exact v0) (by rw [k2 _ (by rw [rv_dM1]; omega)]; exact v1)
    (by rw [k2 _ (by rw [rv_dM2]; omega)]; exact v2) (by rw [k2 _ (by rw [rv_dM3]; omega)]; exact v3)
