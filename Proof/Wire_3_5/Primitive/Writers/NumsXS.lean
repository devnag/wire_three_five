  StarNums.starCost P.n cr 0 + 1 + ((3 * (P.s) + 1) + 1 + ((3 * (P.b) + 1) + 1 + ((3 * (P.r / 2) + 1) + 1 + ((3 * (P.n - P.r * P.b) + 1) + 1 + ((3 * (P.s * (P.r / 2)) + 1) + 1 + ((3 * (P.k) + 1) + 1 + ((UnaryPow.sq cap) + 1 + (((Ledger.rowBt h0 h1 P.n + 5) * (40 * UnaryPow.sq cap)) + 1 + ((3 * (Nat.clog 2 (P.n + 2)) + 1) + 1 + ((3 * (Ledger.rowBLambda h0 h1 2 P.n) + 1) + 1 + ((((cap + 2) * 200 + 1500) * UnaryPow.sq cap))))))))))))

