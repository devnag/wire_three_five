  fun a b h => Fin.ext (by have := congrArg Fin.val h; simp at this; omega)⟩

theorem Gs_val (i : Fin 24) : (Gs i).val = i.val + 8 := rfl

/-- The cap's block: `n, r, s_p, L`, the mode bit, then every other register (`B_S` in `Hc 13 = 12`). -/
