/-- The star width at `n` (`kOf` does not read the call family). -/
noncomputable def kF (l : Literals) (F : GateFree l) (n : ℕ) : ℕ := ((gate0 l F).budget 0 0 0 0 (Nat.zero_le _)).kOf n

/-- **The child's step bound** `K_ch(n) = 2^{n − k + d_A L − 4}`. -/
noncomputable def symKch (l : Literals) (F : GateFree l) (c : SymC) (n : ℕ) : ℕ :=
  2 ^ (n - kF l F n + c.dA * Nat.clog 2 (n + 2) - 4)

