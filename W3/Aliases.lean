/-- Roots whose namespaces the toolchain or Mathlib also populate are never mirrored (e.g. `Nat`). -/
def foreignRoot (m : Name) : Bool :=
  [`Init, `Lean, `Std, `Mathlib, `Batteries, `Aesop, `Qq, `Plausible, `ProofWidgets, `ImportGraph,
    `LeanSearchClient, `Lake].contains m.getRoot

def aliasBase : CommandElabM Unit := do
  let env ← getEnv
  let univ : Std.HashSet Name := w3Universe.foldl (fun s m => s.insert m) {}
  let mods := env.header.moduleNames
  let modOf (n : Name) : Option Name := (env.getModuleIdxFor? n).map (fun i => mods[i.toNat]!)
  let consts := env.constants.map₁.toList
  let mut roots : Std.HashSet Name := {}
  let mut bad : Std.HashSet Name := {}
  for (n, _) in consts do
    if n.isInternal then continue
    match modOf n with
    | some m =>
      if foreignRoot m then bad := bad.insert n.getRoot else roots := roots.insert n.getRoot
    | none => pure ()
  let rootList := roots.toList.filter (fun r => !bad.contains r && r != `W3)
  let rootSet : Std.HashSet Name := rootList.foldl (fun s r => s.insert r) {}
  let aliases := getAliasState env
  let mut out := env
  let mut added : Nat := 0
  for (n, _) in consts do
    if n.isInternal || !rootSet.contains n.getRoot then continue
    let some m := modOf n | continue
    if univ.contains m then continue
    let a := `W3 ++ n
    if env.contains a || (aliases.find? a).isSome then continue
    out := Lean.addAlias out a n
    added := added + 1
  for ns in env.getNamespaces.toList do
    if rootSet.contains ns.getRoot && !(out.isNamespace (`W3 ++ ns)) then
      out := out.registerNamespace (`W3 ++ ns)
  setEnv out
  logInfo m!"w3_alias_base: {added} aliases, {rootList.length} mirrored roots"

/-- See `aliasBase`. -/
elab "w3_alias_base" : command => aliasBase

end W3.Port
